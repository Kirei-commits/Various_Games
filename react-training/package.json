{
  "name": "react-training",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React アプリ設計・実践研修（全4回）の教材アプリ",
  "scripts": {
    "dev": "vite",
    "start": "node tests/serve.mjs",
    "build": "node tools/build.mjs",
    "lint": "node tools/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "test:logic": "tsc --noEmit && vitest run",
    "test:e2e": "playwright test",
    "test": "npm run lint && npm run test:logic && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
