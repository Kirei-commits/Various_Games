{
  "name": "minigame-rush",
  "version": "1.0.0",
  "private": true,
  "description": "ミニゲームラッシュ — 単一HTMLで遊べるミニゲーム集（1本目: 武器拾いレギオン）。src/ から index.html をビルド",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "start": "node tests/serve.mjs",
    "measure": "node tools/measure.mjs",
    "lint": "node tests/lint.mjs",
    "test:logic": "node --test tests/logic/*.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run lint && npm run test:logic && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  },
  "engines": { "node": ">=20" }
}
