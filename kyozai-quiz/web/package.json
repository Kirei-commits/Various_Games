{
  "name": "kyozai-quiz-web",
  "version": "0.1.0",
  "private": true,
  "description": "教材クイズのブラウザ版（静的ファイルだけで動く。GitHub Pages で公開）",
  "type": "module",
  "scripts": {
    "start": "node tests/serve.mjs",
    "test:logic": "node --test tests/logic/*.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:logic && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "jsdom": "26.1.0",
    "jszip": "3.10.1"
  },
  "engines": { "node": ">=20" }
}
