    },
    "hype": {
      "voices": ["Fenrir", "Leda"],
      "_voices": "Fenrir = 男性・熱い / Leda = 女性・若々しく元気。バトル用",
      "style": "An excited video game announcer hyping up the player in a fantasy battle. Short, punchy and energetic American English."
    },
    "gentle": {
      "voices": ["Sulafat", "Achird"],
      "_voices": "Sulafat = 女性・あたたかい / Achird = 男性・親しみやすい。まちがえたとき用",
      "style": "A kind, reassuring American English teacher encouraging a learner who just made a mistake. Warm, calm and supportive, never disappointed."
    }
  },
