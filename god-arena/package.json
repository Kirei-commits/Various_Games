{
  "name": "god-arena",
  "version": "1.0.0",
  "private": true,
  "description": "GOD ARENA — ビルド不要の属性つき多人数バトル（ゴッドフィールド風）",
  "type": "module",
  "scripts": {
    "start": "node tests/serve.mjs",
    "lint": "node tests/lint.mjs",
    "test:logic": "node --test tests/logic/*.test.mjs",
    "test:e2e": "playwright test",
    "playtest": "node tests/playtest.mjs",
    "test": "npm run lint && npm run test:logic && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  },
  "engines": { "node": ">=20" }
}
