{
  "name": "renshu-ginko",
  "version": "0.1.0",
  "private": true,
  "description": "練習銀行アカデミー — 新卒〜中堅がAI前提の開発プロセスを段階的に練習するアプリ（静的ファイルだけで動く）",
  "type": "module",
  "scripts": {
    "start": "node tests/serve.mjs",
    "lint": "node tests/lint.mjs",
    "test:logic": "node tests/coverage.mjs",
    "test:e2e": "playwright test",
    "test": "npm run lint && npm run test:logic && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
