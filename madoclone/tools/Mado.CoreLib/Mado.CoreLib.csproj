<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core と Data のソースを取り込むライブラリ。Unity 6 が使える C# と API に合わせて固定する（docs/02 第2節）。
       Mado.Sim などの実行ファイルとテストは、これを参照する。 -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Mado.CoreLib</AssemblyName>
    <RootNamespace>Mado</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Unity 側は公式パッケージ com.unity.nuget.newtonsoft-json（Packages/manifest.json）。バージョンは 13.x で揃える。 -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Game/Data/**/*.cs" />
    <Compile Include="../../Assets/Game/Core/**/*.cs" />
  </ItemGroup>

</Project>
