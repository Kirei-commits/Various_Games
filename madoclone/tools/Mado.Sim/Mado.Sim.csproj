<Project Sdk="Microsoft.NET.Sdk">

  <!-- 開発用のコンソール。コマンド：validate／golden／battle（docs/04 4節・10節）。Unity には入れない。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Mado.Sim</RootNamespace>
    <AssemblyName>Mado.Sim</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- ゴールデンの型と読み書きは、テストと共有する（NUnit には依存しない）。 -->
    <Compile Include="../../Assets/Game/Tests/Core/Golden/GoldenSupport.cs" Link="GoldenSupport.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Mado.CoreLib/Mado.CoreLib.csproj" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
  </ItemGroup>

</Project>
