<Project Sdk="Microsoft.NET.Sdk">

  <!--
    View（Assets/Game/View）が型として通るかの確認用。Unity は動かさず、UnityStubs の「形だけの UnityEngine」に対してコンパイルする。
    Unity 側と同じく C# 9。ここで通っても Unity で動く保証はないが、名前の間違い・引数の間違い・Core の API とのずれは見つかる。
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Mado.ViewCheck</AssemblyName>
    <RootNamespace>Mado.View</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Game/View/**/*.cs" />
    <ProjectReference Include="../Mado.CoreLib/Mado.CoreLib.csproj" />
    <ProjectReference Include="../UnityStubs/UnityStubs.csproj" />
  </ItemGroup>

</Project>
