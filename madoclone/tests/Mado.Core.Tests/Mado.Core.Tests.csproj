<Project Sdk="Microsoft.NET.Sdk">

  <!-- dotnet test 用。テストのソースは Assets/Game/Tests を参照するだけ（Unity の EditMode テストと同じ実体）。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Game/Tests/Core/**/*.cs" />
    <Compile Include="../../Assets/Game/Tests/Data/**/*.cs" />
    <!-- dotnet だけのテスト（Unity には入れない開発ツールの部品）。 -->
    <Compile Include="../../tools/Mado.Sim/SimPolicy.cs" Link="Sim/SimPolicy.cs" />
    <Compile Include="../../tools/Mado.Sim/RewardsPlan.cs" Link="Sim/RewardsPlan.cs" />
    <Compile Include="../../tools/Mado.Sim/EconomyBot.cs" Link="Sim/EconomyBot.cs" />
    <Compile Include="../Sim/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../tools/Mado.CoreLib/Mado.CoreLib.csproj" />
  </ItemGroup>

</Project>
